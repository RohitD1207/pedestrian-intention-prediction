  "key_findings": [
    "LSTM and Transformer have broadly comparable baseline predictive performance on the common test split.",
    "KL uncertainty is substantially better than Mahalanobis distance for detecting prediction errors for both architectures.",
    "Combining KL and Mahalanobis reduces selective risk further than either signal alone.",
    "The uncertainty behavior is qualitatively consistent across both temporal architectures."
  ],
  "reviewer_guardrails": [
    "Do not call sub-1-percentage-point accuracy differences a strong performance improvement.",
    "Selective prediction reduces risk among retained predictions; it does not solve the fallback decision for rejected cases.",
    "Do not present the results as evidence of six-nines autonomous-driving safety.",
    "Keep recall prominent alongside accuracy, precision, and F1."
  ],
  "data_quality_notes": [
    "Transformer KL thresholds were corrected using its own validation KL distribution; the 95th percentile is 0.01905750.",
    "The Mahalanobis 95th-percentile threshold is 42.3619 for both models because both use the same ResNet feature space and training split.",
    "Earlier Transformer threshold-dependent results using the LSTM KL threshold were superseded by the corrected runs."
  ]
